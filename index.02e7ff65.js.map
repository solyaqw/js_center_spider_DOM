"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
function centerSpider() {
    wall.style.position = "relative";
    spider.style.position = "absolute";
    var wallWidth = wall.clientWidth;
    var wallHeight = wall.clientHeight;
    var spiderWidth = spider.clientWidth;
    var spiderHeight = spider.clientHeight;
    var left = (wallWidth - spiderWidth) / 2;
    var toP = (wallHeight - spiderHeight) / 2;
    spider.style.left = Math.round(left) + "px";
    spider.style.top = Math.round(toP) + "px";
    spider.style.margin = "0";
    spider.style.padding = "0";
    spider.style.transform = "none";
}
centerSpider();
window.addEventListener("load", centerSpider);
window.addEventListener("resize", centerSpider);

